# ─── Adaptive Workspace → Notion ─────────────────────────────────────────────
# 1. Crie uma Internal Integration em https://www.notion.so/my-integrations
# 2. Copie o secret para NOTION_TOKEN
# 3. Abra a página "Adaptive Workspace" e compartilhe com a integration (Full access)
# 4. Os IDs abaixo são data_source_id das collections (Notion API v5)

NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=39d5615ab27481b2892cff223534f8ba
NOTION_PROGRESS_DB_ID=b1259739-108d-4b52-9eeb-72295b8dd456
NOTION_ASSESSMENTS_DB_ID=1ddf0448-973c-4f2e-93e7-6277a4929390
NOTION_SESSIONS_DB_ID=20e5c351-ee7f-4747-8471-5bf9c47e2771

# Opcional — legado. O painel Acompanhamento lê o Notion no servidor (sem campo na tela).
ADAPTIVE_OPS_SECRET=

# ─── Área do Cliente → Entregas (GitHub) ─────────────────────────────────────
# PAT fine-grained com acesso read-only (Contents, Pull requests, Deployments)
# aos repositórios dos projetos do cliente. Necessário para repos privados e
# para não esbarrar no rate limit da API pública.
# Aceita GITHUB_TOKEN ou GITHUB_PAT.
GITHUB_TOKEN=
# GITHUB_PAT=

# ─── Área do Cliente → Documentos (Vercel Blob) ──────────────────────────────
# Store do Vercel Blob usado para guardar os arquivos enviados na aba Documentos
# (xlsx, docx, pdf, imagens) e o índice de metadados/artefatos gerados.
# Crie em Vercel → Storage → Blob e rode `vercel env pull` para o dev local.
BLOB_READ_WRITE_TOKEN=

# ─── Área do Cliente → Inteligência (OpenAI) ─────────────────────────────────
# Usada na análise de Entregas, briefings de Reuniões e enrichment do Backlog.
# Modelo padrão: gpt-4o-mini.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Modelo preferencial para specs agent-ready no Backlog (coding).
# OPENAI_CODING_MODEL=gpt-4.1

# ─── Área do Cliente → Login por workspace ───────────────────────────────────
# Cookie httpOnly assinado. Fallback: ADAPTIVE_OPS_SECRET.
CLIENT_SESSION_SECRET=
# JSON: [{"slug":"likeme","password":"..."},{"slug":"be180-ooh","password":"..."},{"slug":"orfeu","password":"..."},{"slug":"cadence","password":"..."},{"slug":"adaptive-layer","password":"..."}]
CLIENT_ACCESS=

# ─── Área do Cliente → Fontes de dados externas ──────────────────────────────
# Segredo longo (32+ caracteres) usado para criptografar credenciais PostgreSQL no Neon.
DATA_SOURCE_ENCRYPTION_KEY=

# ─── Be180 · bancos externos (não reutilizar POSTGRES_* do Neon) ─────────────
# BE180_COLMEIA_SQL_SERVER=
# BE180_COLMEIA_SQL_USER=
# BE180_COLMEIA_SQL_PASSWORD=
# BE180_COLMEIA_SQL_DATABASE=
# BE180_ATIVOS_PG_HOST=
# BE180_ATIVOS_PG_PORT=5432
# BE180_ATIVOS_PG_DATABASE=
# BE180_ATIVOS_PG_USER=
# BE180_ATIVOS_PG_PASSWORD=

# ─── Like:Me · Supabase (Consultar / Copilot) ────────────────────────────────
# Não use estas credenciais como DATABASE_URL do Cadence — o Neon permanece separado.
# SUPABASE_PROJECT_URL=
# SUPABASE_API_KEY=
# SUPABASE_DB_PASSWORD=
# SUPABASE_USE_POOLING=true
# Obrigatório em produção: db.<ref>.supabase.co só resolve em IPv6 e as funções
# da Vercel não alcançam. Copie a connection string de "Connection pooling".
# SUPABASE_POOLER_URL=aws-1-us-east-1.pooler.supabase.com:5432
# SUPABASE_IMAGES_BUCKET_API_KEY=
# SUPABASE_IMAGES_BUCKET_NAME=images

# ─── WhatsApp Business → Twilio ──────────────────────────────────────────────
# SID e token da conta. Nunca exponha com prefixo NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número WhatsApp no formato whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# URL pública exata do webhook (necessária para validar X-Twilio-Signature).
TWILIO_WEBHOOK_URL=
# JSON opcional: [{"from":"whatsapp:+15553533015","clientSlug":"be180-ooh","boardId":"cadence"}]
# TWILIO_WHATSAPP_ROUTING=

# ─── Be180 · MCP + bot de Slack ──────────────────────────────────────────────
# Token que o bot (e qualquer outro cliente MCP) envia em Authorization: Bearer.
# Gere um segredo longo. Sem ele, /api/mcp recusa todas as chamadas.
BE180_MCP_TOKEN=
# Origem pública deste app, sem barra no final. O bot chama ${MCP_SERVER_URL}/api/mcp.
# Local: http://localhost:3000 com `vercel dev`. Produção: a URL da Vercel.
MCP_SERVER_URL=
# Signing secret do app Slack (Basic Information → App Credentials).
SLACK_SIGNING_SECRET=
# Bot token (OAuth & Permissions), prefixo xoxb-.
SLACK_BOT_TOKEN=

# ─── Be180 · piloto Monday (quadro Chamados_Tech) ────────────────────────────
# O item nasce no quadro Chamados_Tech. O agente Cadence é atribuído ou mencionado,
# o Cadence enriquece a user story e devolve no mesmo item.
# Na Monday: Agents → Conectar agente de qualquer provedor → Sim.
# URL do webhook: https://pixelpulselab.dev/api/webhooks/monday/be180
# Nome sugerido: Cadence (agent id, api_token e signing_secret ficam só uma vez
# na tela de sucesso — guarde-os imediatamente).
MONDAY_AGENT_API_TOKEN=
MONDAY_AGENT_SIGNING_SECRET=
# Quadro Chamados_Tech: https://be180-force.monday.com/boards/18413193469
BE180_MONDAY_BOARD_ID=18413193469
BE180_MONDAY_ACCOUNT_SLUG=be180-force
# Board do Cadence que recebe o item. Padrão: colmeia.
# BE180_MONDAY_CADENCE_BOARD=colmeia

# ─── Alquemia → Space de transformação ───────────────────────────────────────
# Credenciais server-side. Nunca exponha estas variáveis com prefixo NEXT_PUBLIC_.
ALQUIMIA_SESSION_SECRET=
ALQUIMIA_ADMIN_PASSWORD=
# JSON: [{"sub":"cliente","name":"Cliente","role":"client","engagementIds":["slug"],"password":"..."}]
ALQUIMIA_CLIENT_ACCESS=
